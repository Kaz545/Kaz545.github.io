{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

{% if site.data.repositories.github_users contains repo_owner %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 3 %}
{% endif %}

{% assign repo_meta = nil %}
{% for meta in site.data.repositories.repo_meta %}
  {% if meta.repo == include.repository %}
    {% assign repo_meta = meta %}
  {% endif %}
{% endfor %}

{% comment %} Rough GitHub-style language color map; unknown languages fall back to a neutral grey dot. {% endcomment %}
{% assign lang_colors = "Python:#3572A5|Jupyter Notebook:#DA5B0B|JavaScript:#f1e05a|TypeScript:#3178c6|HTML:#e34c26|CSS:#563d7c|R:#198CE7|Shell:#89e051|C++:#f34b7d|Java:#b07219" | split: "|" %}
{% assign lang_color = "#8b949e" %}
{% if repo_meta.language %}
  {% for pair in lang_colors %}
    {% assign kv = pair | split: ":" %}
    {% if kv[0] == repo_meta.language %}
      {% assign lang_color = kv[1] %}
    {% endif %}
  {% endfor %}
{% endif %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card-header">
      <svg class="repo-card-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"
        ></path>
      </svg>
      <span class="repo-card-name">{% if show_owner %}{{ repo_owner }}/{% endif %}{{ repo_name }}</span>
    </div>

    {% if repo_meta.description %}
      <p class="repo-card-desc" style="-webkit-line-clamp: {{ max_lines }};">{{ repo_meta.description }}</p>
    {% endif %}

    <div class="repo-card-footer">
      {% if repo_meta.language %}
        <span class="repo-card-lang">
          <span class="repo-card-lang-dot" style="background-color: {{ lang_color }};"></span>
          {{ repo_meta.language }}
        </span>
      {% endif %}
      {% if repo_meta.stars %}
        <span class="repo-card-stars">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
            ></path>
          </svg>
          {{ repo_meta.stars }}
        </span>
      {% endif %}
    </div>
  </a>
</div>
