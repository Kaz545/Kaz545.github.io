<div class="repo p-2">
  <a class="repo-card repo-user-card" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <img
      class="repo-user-avatar"
      src="https://github.com/{{ include.username }}.png?size=112"
      alt="{{ include.username }}"
      width="56"
      height="56"
      loading="lazy"
    />
    <span class="repo-card-name">@{{ include.username }}</span>
  </a>
</div>
